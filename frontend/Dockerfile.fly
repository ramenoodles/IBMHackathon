FROM node:22-alpine AS build

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts ./scripts
COPY public ./public
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

FROM nginx:alpine

COPY nginx.fly.conf.template /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.fly.sh /docker-entrypoint.fly.sh
RUN sed -i 's/\r$//' /docker-entrypoint.fly.sh && chmod +x /docker-entrypoint.fly.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.fly.sh"]
